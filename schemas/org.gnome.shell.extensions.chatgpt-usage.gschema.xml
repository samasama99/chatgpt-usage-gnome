<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.chatgpt-usage"
          path="/org/gnome/shell/extensions/chatgpt-usage/">
    <key name="show-panel-icon" type="b">
      <default>true</default>
      <summary>Show the ChatGPT icon in the panel</summary>
    </key>
    <key name="show-local-activity" type="b">
      <default>true</default>
      <summary>Show local Codex and OpenCode activity</summary>
    </key>
    <key name="panel-position" type="s">
      <default>'right'</default>
      <summary>Panel box for the indicator</summary>
    </key>
    <key name="panel-background-enabled" type="b">
      <default>false</default>
      <summary>Show a colored background behind the panel indicator</summary>
    </key>
    <key name="panel-background-color" type="s">
      <default>'#10a37f'</default>
      <summary>Panel indicator background color</summary>
    </key>
  </schema>
</schemalist>
