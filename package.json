{
  "name": "chatgpt-usage-gnome",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Polished GNOME Shell usage monitor for ChatGPT/Codex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samasama99/chatgpt-usage-gnome.git"
  },
  "license": "GPL-2.0-or-later",
  "sideEffects": false,
  "scripts": {
    "security-check": "node scripts/security-check.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts-copy-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run security-check && npm run typecheck && npm run build && npm test",
    "pack:extension": "npm run build && (cd extension && zip -qr ../chatgpt-usage@samasama99.shell-extension.zip .)"
  },
  "devDependencies": {
    "@girs/gjs": "5.4.0",
    "@girs/gnome-shell": "50.0.4",
    "@girs/soup-3.0": "5.4.0",
    "typescript": "7.0.2"
  }
}
