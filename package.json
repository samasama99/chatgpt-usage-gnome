{
  "name": "quota-monitor-gnome",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "GNOME Shell extension for ChatGPT/Codex usage limits",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samasama99/chatgpt-usage-gnome.git"
  },
  "license": "GPL-2.0-or-later",
  "sideEffects": false,
  "scripts": {
    "security-check": "node scripts/security-check.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts-copy-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "store-check": "node scripts/store-check.mjs",
    "check": "npm run security-check && npm run typecheck && npm run build && npm test && npm run store-check",
    "pack:store": "npm run build && (cd extension && zip -qr ../quota-monitor@samasama99.github.io.shell-extension.zip .)",
    "pack:extension": "npm run pack:store"
  },
  "devDependencies": {
    "@girs/gjs": "5.0.0",
    "@girs/gnome-shell": "50.0.4",
    "typescript": "5.8.3",
    "@girs/soup-3.0": "4.7.0"
  }
}
